@startuml ARCH-04b-候选部署图-华为云能力映射
title 图 ARCH-04b 候选部署图·华为云能力映射（华为云 CodeArts Modeling 规范标准）
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam roundCorner 6
skinparam linetype ortho

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
  ArrowColor #1565C0
  ArrowThickness 1.2
}

skinparam artifact {
  BackgroundColor #FAFAFA
  BorderColor #455A64
  FontSize 10
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 10
}

skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
}

node "用户终端设备\n<<device>> Android 12+ / Win 11" as Node_Clients #F1F8E9 {
  artifact "客户端安装包 (APK / EXE)" as Client_Artifacts
}

package "华为云产品能力映射边界 (Huawei Cloud Infrastructure)" as HuaweiCloud #EDE7F6 {

  node "弹性计算与容器托管\n<<executionEnvironment>> 华为云 ECS / CCE" as HW_Compute {
    artifact "Ingress 容器网关" as HW_Ingress
    artifact "sync-service (同步服务)" as HW_Sync
    artifact "rag-gateway (AI 网关)" as HW_AI
    artifact "task-worker (后台任务)" as HW_Worker
    
    HW_Ingress --> HW_Sync : 内部 HTTP
    HW_Ingress --> HW_AI : 内部 HTTP
  }

  node "托管关系型数据库\n<<database system>> 华为云 RDS for PostgreSQL" as HW_RDS {
    database "PostgreSQL 16 实例\n(自动备份/高可用)" as HW_PG_DB #D1C4E9
  }

  node "云运维与可观测服务\n<<support>> 华为云 LTS + AOM" as HW_Obs {
    artifact "LTS 结构化调用日志" as HW_LTS
    artifact "AOM 监控大屏 / 性能指标" as HW_AOM
  }

  node "密钥管理服务\n<<security>> 华为云 DEW / KMS" as HW_Security {
    artifact "KMS 统一凭据管理" as HW_KMS
  }

  HW_Sync --> HW_PG_DB : JDBC / SSL (端口 5432)
  HW_AI --> HW_PG_DB : JDBC / SSL (端口 5432)
  HW_Worker --> HW_PG_DB : JDBC / SSL (端口 5432)

  HW_Security ..> HW_Compute : 注入 API 密钥与数据库凭据
  HW_Compute ..> HW_Obs : 上报内容无关指标
}

cloud "外部模型基础设施\n<<node>> OpenAI Cloud" as OpenAI_Cloud #FFF3E0 {
  artifact "Responses API (候选模型快照)" as Ext_API
}

Client_Artifacts --> HW_Ingress : HTTPS (TCP 443)
HW_AI --> Ext_API : HTTPS (TCP 443)

@enduml
