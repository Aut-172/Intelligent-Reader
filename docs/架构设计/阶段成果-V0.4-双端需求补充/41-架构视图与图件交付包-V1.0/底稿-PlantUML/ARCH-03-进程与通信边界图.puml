@startuml ARCH-03-进程与通信边界图
title 图 ARCH-03 进程拓扑与端云通信边界图（华为云 CodeArts Modeling 规范标准）
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam roundCorner 6
skinparam linetype ortho

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
  ArrowColor #1565C0
  ArrowThickness 1.2
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
}

skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
}

node "Android 客户端进程\n<<process>>\ncom.reader.android" as Proc_Android #F1F8E9
node "Windows 客户端进程\n<<process>>\nIntelligentReader.exe" as Proc_Windows #E1F5FE

package "服务端宿主环境 (课程一期可同机)" as Host_Server #EDE7F6 {
  node "反向代理进程\n<<process>>\ningress-proxy" as Proc_Proxy
  node "身份与同步进程\n<<process>>\nsync-service" as Proc_Sync
  node "AI 网关进程\n<<process>>\nrag-gateway" as Proc_AI
  node "任务工作者进程\n<<process>>\ntask-worker" as Proc_Worker
  database "数据库进程\n<<process>>\nPostgreSQL 16" as Proc_DB #D1C4E9
  
  Proc_Proxy --> Proc_Sync : 本地 HTTP 转发
  Proc_Proxy --> Proc_AI : 本地 HTTP 转发
  Proc_Sync --> Proc_DB : TCP / libpq (原子事务)
  Proc_AI --> Proc_DB : TCP / libpq (记录审计)
  Proc_Worker --> Proc_DB : TCP / libpq (Lease 抢占)
}

cloud "外部受控模型端点\n<<external host>>\napi.openai.com" as Remote_AI #FFF3E0

Proc_Android --> Proc_Proxy : HTTPS (REST push/pull & SSE)
Proc_Windows --> Proc_Proxy : HTTPS (REST push/pull & SSE)
Proc_AI --> Remote_AI : HTTPS (Responses API)

@enduml
