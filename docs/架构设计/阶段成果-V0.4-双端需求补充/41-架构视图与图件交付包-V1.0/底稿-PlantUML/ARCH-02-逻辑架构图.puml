@startuml ARCH-02-逻辑架构图
title 图 ARCH-02 逻辑架构分层总览图（华为云 CodeArts Modeling 规范标准 5 层架构）
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam roundCorner 6
skinparam linetype ortho
top to bottom direction

skinparam package {
  BackgroundColor transparent
  BorderColor #546E7A
  FontStyle bold
  FontSize 12
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
  ArrowColor #1565C0
  ArrowThickness 1.2
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
}

skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
}

package "第 1 层：接入与展现层 (Presentation Layer)" as L1 #EBF3FB {
  component "AndroidComposeUI\n<<boundary>>" as UI_And
  component "WindowsDesktopUI\n<<boundary>>" as UI_Win
  component "AdminCliEndpoint\n<<boundary>>" as UI_Admin
}

package "第 2 层：应用编排与用例层 (Application Layer)" as L2 #EAF5EA {
  component "ClientCoordinators\n<<control>>" as App_Client
  component "ServerUseCases\n<<service>>" as App_Server
}

package "第 3 层：核心领域与合同层 (Domain & Contract Layer)" as L3 #FFF8E1 {
  component "KMPSharedCore\n<<candidate domain>>" as Dom_Shared
  component "ServerContracts\n<<contract>>" as Dom_Server
}

package "第 4 层：平台适配与驱动层 (Adaptation Layer)" as L4 #F3E8FD {
  component "AndroidAdapters\n<<adapter>>" as Adp_And
  component "WindowsAdapters\n<<adapter>>" as Adp_Win
  component "ServerDrivers\n<<adapter>>" as Adp_Server
}

package "第 5 层：基础设施与数据层 (Infrastructure Layer)" as L5 #F1F5F9 {
  database "ClientSandboxStorage" as DB_Client
  database "PostgreSQL 16" as DB_Server
  cloud "OpenAI API" as Cloud_Ext
}

package "正交切面关注点 (Cross-Cutting)" as L_Cross #FDF2F2 {
  component "PolicyGate\n<<cross-cutting>>" as Cross_Policy
  component "SyncRecoveryEngine\n<<cross-cutting>>" as Cross_Sync
  component "AuditTelemetryLogger\n<<cross-cutting>>" as Cross_Audit
}

' 垂直层级约束
L1 -[hidden]down-> L2
L2 -[hidden]down-> L3
L3 -[hidden]down-> L4
L4 -[hidden]down-> L5

' 上下层调用依赖
UI_And --> App_Client
UI_Win --> App_Client
UI_Admin --> App_Server

App_Client --> Dom_Shared
App_Server --> Dom_Server

Adp_And .up.|> Dom_Shared : 依赖倒置实现
Adp_Win .up.|> Dom_Shared : 依赖倒置实现
App_Server --> Adp_Server

Adp_And --> DB_Client
Adp_Win --> DB_Client
Adp_Server --> DB_Server
Adp_Server --> Cloud_Ext

Cross_Policy ..> App_Client : 权限门控
Cross_Sync ..> App_Client : 离线状态
Cross_Audit ..> App_Server : 审计日志

@enduml
