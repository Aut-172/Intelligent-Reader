@startuml ARCH-02-细化拆分-双端与共享核心协作图
title 图 ARCH-02-细化拆分 端侧分层与KMP共享核心端口协作图（CodeArts Modeling 规范 / 六边形端口适配拆分视图）
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam roundCorner 6
skinparam linetype ortho
left to right direction

skinparam package {
  BackgroundColor transparent
  BorderColor #546E7A
  FontStyle bold
  FontSize 12
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
  ArrowColor #1565C0
  ArrowThickness 1.2
}

skinparam interface {
  BackgroundColor #FFE082
  BorderColor #FF8F00
  FontSize 10
}

package "Android 移动端平台环境" as P_Android #F1F8E9 {
  package "Android 展现与接入" {
    component "ComposeReaderScreen\n<<boundary>>" as UI_And
  }
  package "Android 专用适配器 (Adapters)" {
    component "AndroidDocParserAdapter\n<<adapter>>\nPdfRenderer + OCR 驱动" as Adp_And_Doc
    component "AndroidRoomStorageAdapter\n<<adapter>>\nRoom / SQLite 本地仓储" as Adp_And_Store
    component "AndroidKeystoreAdapter\n<<adapter>>\n硬件凭据安全存储" as Adp_And_Sec
    component "AndroidWorkManagerAdapter\n<<adapter>>\n持久任务后台宿主" as Adp_And_Task
  }
  UI_And --> Adp_And_Doc
  UI_And --> Adp_And_Store
}

package "KMP 共享领域核心 (Candidate Shared Core)" as P_Core #FFF8E1 {
  
  package "端口定义 (Ports / Abstract Interfaces)" as P_Ports {
    interface "IDocumentParserPort\n<<port>>\n+ parseDocument()\n+ normalizeBBox()" as Port_Parser
    interface "ILocalStoragePort\n<<port>>\n+ saveOperation()\n+ getPendingOps()" as Port_Store
    interface "ISecureStorePort\n<<port>>\n+ getAuthToken()\n+ saveCredentials()" as Port_Sec
    interface "IModelGatewayPort\n<<port>>\n+ sendEvidenceStream()\n+ cancelRequest()" as Port_Net
  }

  package "纯领域模型与状态机 (Pure Domain)" as P_Domain {
    component "DocumentIdentity\n<<entity>>\n不可变身份与SourceHash" as Core_Doc
    component "CitationAnchor\n<<entity>>\n结构与字符双锚点" as Core_Cit
    component "SyncStateMachine\n<<control>>\n操作流与冲突仲裁" as Core_Sync
  }

  Core_Sync --> Port_Store : 读写操作流
  Core_Sync --> Port_Sec : 获取凭据
  Core_Doc --> Port_Parser : 统一解析中间表示
}

package "Windows 桌面端平台环境" as P_Windows #E1F5FE {
  package "Windows 展现与接入" {
    component "WinDesktopReaderWindow\n<<boundary>>" as UI_Win
  }
  package "Windows 专用适配器 (Adapters)" {
    component "WinDocParserAdapter\n<<adapter>>\nWindows.Data.Pdf + OCR" as Adp_Win_Doc
    component "WinSqliteStorageAdapter\n<<adapter>>\n桌面 SQLite 本地仓储" as Adp_Win_Store
    component "WinCredentialAdapter\n<<adapter>>\nDPAPI 凭据安全存储" as Adp_Win_Sec
    component "WinTaskHostAdapter\n<<adapter>>\n桌面持久任务线程宿主" as Adp_Win_Task
  }
  UI_Win --> Adp_Win_Doc
  UI_Win --> Adp_Win_Store
}

package "远端通信适配 (Remote Network Adapter)" as P_Remote #F3E8FD {
  component "KtorClientAdapter\n<<adapter>>\nHTTPS REST/JSON + SSE Client" as Adp_Net_Client
}

' 依赖倒置实现 (Adapters implement Ports)
Adp_And_Doc ..|> Port_Parser : 实现解析端口
Adp_Win_Doc ..|> Port_Parser : 实现解析端口

Adp_And_Store ..|> Port_Store : 实现持久化端口
Adp_Win_Store ..|> Port_Store : 实现持久化端口

Adp_And_Sec ..|> Port_Sec : 实现凭据端口
Adp_Win_Sec ..|> Port_Sec : 实现凭据端口

Adp_Net_Client ..|> Port_Net : 实现远端模型网关端口

note bottom of P_Core
  **KMP 纯度隔离契约 (ADR-012, ADR-028):**
  1. 共享核心只包含纯 Kotlin 业务逻辑，不依赖任何 Android Context、Windows Handle 或原生 SDK。
  2. 依赖倒置：核心只定义端口 (Port)，平台通过适配器 (Adapter) 注入实现。
end note

@enduml
