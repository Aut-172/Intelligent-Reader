@startuml ARCH-04a-候选部署图-云中立基线
title 图 ARCH-04a 候选部署图·云中立基线（华为云 CodeArts Modeling 规范标准）
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam roundCorner 6
skinparam linetype ortho

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
  ArrowColor #1565C0
  ArrowThickness 1.2
}

skinparam artifact {
  BackgroundColor #FAFAFA
  BorderColor #455A64
  FontSize 10
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 10
}

skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 11
}

node "用户移动设备\n<<device>> Android 12+" as Node_Android #F1F8E9 {
  artifact "IntelligentReader.apk\n<<artifact>>" as Art_APK
  database "本地沙箱存储" as Store_Android #DCEDC8
  Art_APK --> Store_Android
}

node "用户桌面电脑\n<<device>> Windows 11" as Node_Windows #E1F5FE {
  artifact "IntelligentReader.exe\n<<artifact>>" as Art_EXE
  database "AppData 本地存储" as Store_Win #D1E8F8
  Art_EXE --> Store_Win
}

node "云中立计算节点\n<<node>> Linux (Ubuntu 22.04 LTS)\n[课程一期单机一体化部署基线]" as Node_Server #EDE7F6 {
  
  node "反向代理网关\n<<executionEnvironment>> Ingress" as Env_Proxy {
    artifact "Caddy / Nginx" as Art_Proxy
  }

  node "Java 21 运行时环境\n<<executionEnvironment>> App Runtime" as Env_AppRuntime {
    artifact "sync-service.jar\n<<artifact>>" as Art_Sync
    artifact "rag-gateway.jar\n<<artifact>>" as Art_AI
    artifact "task-worker.jar\n<<artifact>>" as Art_Worker
  }

  node "数据库运行时环境\n<<executionEnvironment>> DB Runtime" as Env_DBRuntime {
    database "PostgreSQL 16\n<<database system>>" as PG_Inst #D1C4E9
  }

  Art_Proxy --> Art_Sync : HTTP (8081)
  Art_Proxy --> Art_AI : HTTP (8082)
  Art_Sync --> PG_Inst : TCP (5432)
  Art_AI --> PG_Inst : TCP (5432)
  Art_Worker --> PG_Inst : TCP (5432)
}

cloud "外部受控模型基础设施\n<<node>> OpenAI Cloud" as Node_OpenAI #FFF3E0 {
  artifact "Responses API Endpoint" as Art_OpenAI_API
}

Art_APK --> Art_Proxy : HTTPS (TCP 443)
Art_EXE --> Art_Proxy : HTTPS (TCP 443)
Art_AI --> Art_OpenAI_API : HTTPS (TCP 443)

@enduml
