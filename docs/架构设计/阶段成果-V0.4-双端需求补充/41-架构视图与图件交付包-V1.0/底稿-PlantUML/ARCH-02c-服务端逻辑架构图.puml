@startuml ARCH-02c-服务端逻辑架构图
title 图 ARCH-02c 服务端逻辑架构与数据流图（华为云 CodeArts Modeling 规范标准）
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam roundCorner 6
skinparam linetype ortho
top to bottom direction

skinparam package {
  BackgroundColor transparent
  BorderColor #546E7A
  FontStyle bold
  FontSize 11
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 10
  ArrowColor #1565C0
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 10
}

skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontSize 10
}

package "接入与网关层" as P_Edge #EBF3FB {
  component "IngressProxy\n<<boundary>>\n(TLS 1.3 / 限流路由)" as Ingress
}

package "服务用例层 (UseCases)" as P_Service #EAF5EA {
  component "AccountSessionService\n<<service>>" as Svc_Auth
  component "SyncTransactionService\n<<service>>" as Svc_Sync
  component "AIRAGGatewayService\n<<service>>" as Svc_AI
  component "TaskRecoveryService\n<<service>>" as Svc_Worker
}

package "领域契约与DTO层" as P_Contract #FFF8E1 {
  component "AccountEntity\n<<entity>>" as Ent_Account
  component "AccountChangeLog\n<<entity>>" as Ent_Log
  component "EvidencePackageDTO\n<<contract>>" as DTO_Evidence
  component "AsyncTaskRecord\n<<entity>>" as Ent_Task
}

package "持久化与外部适配层" as P_Adapter #F3E8FD {
  component "PostgresSyncRepoAdapter\n<<adapter>>" as Adp_PG_Sync
  component "PostgresTaskRepoAdapter\n<<adapter>>" as Adp_PG_Task
  component "OpenAIModelAdapter\n<<adapter>>" as Adp_OpenAI
}

package "基础设施层" as P_Infra #F1F5F9 {
  database "PostgreSQL 16\n(关系型数据库)" as DB_PG
  cloud "OpenAI API\n(候选大模型)" as Cloud_LLM
}

Ingress --> Svc_Auth : 身份请求
Ingress --> Svc_Sync : 同步请求 (push/pull)
Ingress --> Svc_AI : 证据包 (SSE流)

Svc_Auth --> Ent_Account
Svc_Sync --> Ent_Log
Svc_AI --> DTO_Evidence
Svc_Worker --> Ent_Task

Svc_Sync --> Adp_PG_Sync
Svc_Worker --> Adp_PG_Task
Svc_AI --> Adp_OpenAI

Adp_PG_Sync --> DB_PG
Adp_PG_Task --> DB_PG
Adp_OpenAI --> Cloud_LLM

@enduml
